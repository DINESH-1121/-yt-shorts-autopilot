{
  "name": "yt-shorts-uploader",
  "version": "1.0.0",
  "description": "Download YouTube Shorts / Instagram Reels and upload to your YouTube channel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mlx:start": ".venv-mlx/bin/python -m mlx_lm server --model mlx-community/Qwen3.5-9B-MLX-4bit --port 8080 --chat-template-args '{\"enable_thinking\":false}'",
    "mlx:chat": ".venv-mlx/bin/python -m mlx_lm chat --model mlx-community/Qwen3.5-9B-MLX-4bit"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "open": "^10.1.0"
  }
}
